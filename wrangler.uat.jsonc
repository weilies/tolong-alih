{
  "name": "tolong-alih-uat",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-04",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Binds the hostname and creates its DNS record on deploy. Without this the
  // worker is only reachable on its workers.dev subdomain.
  "routes": [{ "pattern": "uat.alih.nextnovas.com", "custom_domain": true }],
  "vars": {
    "APP_ENV": "uat",
    // Neon project `tolong-alih`, branch `uat`. Neither is a secret: the worker
    // proxies both from /api/auth and /api/rest, and RLS guards the data.
    "NEON_AUTH_URL": "https://ep-fancy-wildflower-b3dc9f55.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth",
    "NEON_DATA_API_URL": "https://ep-fancy-wildflower-b3dc9f55.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb/rest/v1",
    // Web Push (src/push.js). The public half only; VAPID_PRIVATE_KEY is a
    // wrangler secret. Push stays hidden in the app until both are set.
    "VAPID_PUBLIC_KEY": "BKB9qkXmojmwMm6ZNhLBeLhiaU0b0KIAbndw7VhEkgtx6qkWE_MkjsRVHVhxDM4CUGYgOPgIAzDDm3d-33VxkJs",
    "VAPID_SUBJECT": "https://alih.nextnovas.com"
  }
}
