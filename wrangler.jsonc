{
  "name": "tolong-alih",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-04",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Binds the hostname and creates its DNS record on deploy. Without this the
  // worker is only reachable on its workers.dev subdomain.
  "routes": [{ "pattern": "alih.nextnovas.com", "custom_domain": true }],
  "vars": {
    "APP_ENV": "production",
    "APP_SCHEMA": "app_alih_prod",
    // Publishable key. Safe in the repo — it is handed to every browser that
    // loads the page. RLS is what actually guards the data.
    "SUPABASE_URL": "https://llejrncrxjejxvkwqhgj.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_lDV-sDrcjaPBl2yjZYcYFQ_2T5oj6Qd"
  }
}
