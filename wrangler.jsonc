{
  "name": "tolong-alih",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-04",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Binds the hostname and creates its DNS record on deploy. Without this the
  // worker is only reachable on its workers.dev subdomain.
  "routes": [{ "pattern": "alih.nextnovas.com", "custom_domain": true }],
  "vars": {
    // Google Analytics 4 measurement id (G-XXXXXXXXXX) of this app's own property.
    // Empty = analytics off. Public by design, so it can live here. UAT stays empty.
    "GA_MEASUREMENT_ID": "G-1VQPH6GVMX",
    "APP_ENV": "production",
    // Neon project `tolong-alih`, branch `main`. Neither is a secret: the worker
    // proxies both from /api/auth and /api/rest, and RLS guards the data.
    "NEON_AUTH_URL": "https://ep-winter-mouse-b3lrpiom.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth",
    "NEON_DATA_API_URL": "https://ep-winter-mouse-b3lrpiom.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb/rest/v1",
    // Web Push: VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are worker secrets,
    // made once per worker by the deploy workflow — see db/README.md.
    "VAPID_SUBJECT": "https://alih.nextnovas.com"
  }
}
